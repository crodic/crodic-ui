{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": true,
  "tasks": {
    "build:registry": {
      "inputs": ["src/registry/**/*", "scripts/build-registry.mts"],
      "outputs": ["public/r/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:registry"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
